{
  "name": "saanwariya-seth-fashion-store",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "npm run db:push && npm run db:seed",
    "db:verify": "tsx scripts/verify-db.ts",
    "db:admin:reset": "tsx scripts/reset-admin.ts",
    "db:admin:verify": "tsx scripts/verify-admin.ts",
    "check:agent": "powershell -ExecutionPolicy Bypass -File scripts/check-agent-readiness.ps1",
    "db:admin:init": "tsx scripts/initialize-admin-data.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.2",
    "jose": "^6.1.0",
    "lucide-react": "^0.468.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "use-webmcp-tool": "^0.2.0",
    "dotenv": "^16.6.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.7",
    "prisma": "^6.19.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22 <25"
  }
}
