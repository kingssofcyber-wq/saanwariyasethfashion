generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}
enum ProductSource {
  OWN
  FLIPKART
}
enum OrderStatus {
  PLACED
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(USER)
  orders       Order[]
  reviews      ProductReview[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Product {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  brand       String        @default("Saanwariya Select")
  description String        @db.Text
  category    String
  price       Float
  mrp         Float
  image       String        @db.VarChar(1000)
  images      String?       @db.Text
  source      ProductSource @default(OWN)
  externalUrl String?       @db.VarChar(2000)
  stock       Int           @default(10)
  featured    Boolean       @default(false)
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  reviews     ProductReview[]

  @@index([category])
  @@index([featured, active])
}

model Order {
  id           String      @id @default(cuid())
  orderNumber  String      @unique
  userId       String
  user         User        @relation(fields: [userId], references: [id])
  fullName     String
  email        String
  phone        String
  address      String      @db.Text
  city         String
  state        String
  postalCode   String
  subtotal     Float
  shipping     Float
  discount     Float       @default(0)
  couponCode   String?     @db.VarChar(40)
  total        Float
  paymentMethod String     @default("COD")
  status       OrderStatus @default(PLACED)
  items        OrderItem[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([userId, createdAt])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  productName String
  image       String  @db.VarChar(1000)
  price       Float
  quantity    Int
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String   @db.Text
  status    String   @default("NEW") @db.VarChar(20)
  createdAt DateTime @default(now())
}


model ProductReview {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  title     String
  comment   String   @db.Text
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([productId, userId])
  @@index([productId, approved, createdAt])
}


model Coupon {
  id          String   @id @default(cuid())
  code        String   @unique @db.VarChar(40)
  description String   @default("") @db.VarChar(500)
  discountType String  @default("PERCENT") @db.VarChar(20)
  value       Float
  minOrder    Float    @default(0)
  maxDiscount Float?
  usageLimit  Int?
  usedCount   Int      @default(0)
  active      Boolean  @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, startsAt, endsAt])
}

model StoreBanner {
  id        String   @id @default(cuid())
  title     String   @db.VarChar(180)
  subtitle  String   @default("") @db.VarChar(500)
  image     String   @db.VarChar(1000)
  href      String   @default("/shop") @db.VarChar(1000)
  position  String   @default("HOME") @db.VarChar(40)
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([position, active, sortOrder])
}

model StoreSettings {
  id                    String   @id @default("default") @db.VarChar(50)
  storeName             String   @default("Saanwariya Seth Fashion") @db.VarChar(180)
  supportEmail          String   @default("support@saanwariyasethfashion.com") @db.VarChar(191)
  supportPhone          String   @default("") @db.VarChar(40)
  address               String   @db.Text
  announcement          String   @db.Text
  shippingFee           Float    @default(79)
  freeShippingThreshold Float    @default(999)
  instagramUrl          String?  @db.VarChar(1000)
  facebookUrl           String?  @db.VarChar(1000)
  youtubeUrl            String?  @db.VarChar(1000)
  updatedAt             DateTime @updatedAt
}


model StoreCategory {
  id          String   @id @default(cuid())
  name        String   @unique @db.VarChar(100)
  slug        String   @unique @db.VarChar(120)
  description String   @default("") @db.VarChar(500)
  image       String   @db.VarChar(1000)
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, sortOrder])
}
