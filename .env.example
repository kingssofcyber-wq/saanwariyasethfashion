# Hostinger MySQL database connection (create DB + user in hPanel)
DATABASE_URL="mysql://DB_USER:DB_PASSWORD@DB_HOST:3306/DB_NAME"

# Long random secret (minimum 32 characters)
AUTH_SECRET="replace-this-with-a-long-random-secret-at-least-32-characters"

# Initial administrator - change before first deployment, then run npm run db:seed
ADMIN_NAME="Store Administrator"
ADMIN_EMAIL="admin@saanwariyasethfashion.com"
ADMIN_PASSWORD="ChangeThisStrongPassword123!"

# Optional official Flipkart Affiliate API credentials
FLIPKART_AFFILIATE_ID=""
FLIPKART_AFFILIATE_TOKEN=""

# Public site URL
NEXT_PUBLIC_SITE_URL="https://saanwariyasethfashion.com"
